{
  "name": "fox-pet",
  "version": "1.0.0",
  "description": "여우귀 캐릭터 바탕화면 키우기",
  "main": "main.js",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.foxpet.yeoyuno",
    "productName": "여우귀 친구",
    "copyright": "여우귀 친구",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "diary.js",
      "index.html",
      "style.css",
      "package.json",
      "sprites/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "FoxPet-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "여우귀 친구",
      "uninstallDisplayName": "여우귀 친구"
    }
  }
}
