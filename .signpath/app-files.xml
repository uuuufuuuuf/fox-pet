<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app-files": the app folder (zipped by GitHub). Signs every
     exe and dll in it with Authenticode. Paste into SignPath: Project > Artifact configurations. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="**/*.exe" />
      <include path="**/*.dll" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
